# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_BUCKET=stylesense-media

# Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# AI APIs
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=
REPLICATE_API_TOKEN=

# Payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_MONTHLY_ID=
RAZORPAY_PLAN_ANNUAL_ID=

# Comms
MSG91_AUTH_TOKEN=
MSG91_SENDER_ID=
MSG91_OTP_TEMPLATE_ID=
RESEND_API_KEY=

# Monitoring
# SENTRY_DSN_MOBILE/POSTHOG_API_KEY are the wrong shape for the mobile Expo
# client (only EXPO_PUBLIC_-prefixed vars get inlined into the client
# bundle) — the actual mobile-side values live in mobile/.env.local's
# EXPO_PUBLIC_SENTRY_DSN/EXPO_PUBLIC_POSTHOG_API_KEY, copied from these.
SENTRY_DSN_MOBILE=
SENTRY_DSN_BACKEND=
POSTHOG_API_KEY=
# (SS-026) backend-only PostHog feature-flag client host. Defaults to US
# Cloud (https://us.i.posthog.com) in code if unset -- confirmed the correct
# region by BL-048's 2026-07-28 resolution.
POSTHOG_HOST=
# backend/main.py already reads this (falls back to 'development' if unset);
# pre-existing gap in this file, fixed here while already touching it.
ENVIRONMENT=
