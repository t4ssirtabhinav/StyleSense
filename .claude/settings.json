{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/format-on-edit.sh",
            "timeout": 30,
            "statusMessage": "Auto-formatting edited file..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/block-push-main.sh",
            "timeout": 10,
            "statusMessage": "Checking for push-to-main..."
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(git push origin main)",
      "Bash(git push origin master)",
      "Bash(git push --force origin main)",
      "Bash(git push --force origin master)"
    ]
  }
}
