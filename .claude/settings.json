{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/format-on-edit.sh",
            "timeout": 30,
            "statusMessage": "Auto-formatting edited file..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/block-push-main.sh",
            "timeout": 10,
            "statusMessage": "Checking for push-to-main..."
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Edit(mobile/**)",
      "Write(mobile/**)",
      "Edit(backend/**)",
      "Write(backend/**)",
      "Edit(docs/**)",
      "Write(docs/**)",
      "Edit(.claude/**)",
      "Write(.claude/**)",
      "Bash(npx tsc *)",
      "Bash(npx biome *)",
      "Bash(npx jest *)",
      "Bash(npx expo *)",
      "Bash(npx supabase *)",
      "Bash(./venv/Scripts/pytest* *)",
      "Bash(./venv/Scripts/ruff *)",
      "Bash(./venv/Scripts/mypy*)",
      "Bash(./backend/venv/Scripts/pytest* *)",
      "Bash(./backend/venv/Scripts/ruff *)",
      "Bash(./backend/venv/Scripts/mypy*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git branch *)",
      "Bash(git worktree *)",
      "Bash(git stash *)",
      "Bash(git checkout *)",
      "Bash(gh pr *)",
      "Bash(gh run *)",
      "Bash(gh api *)",
      "Bash(npm install *)",
      "Bash(npm ci *)",
      "Bash(npm ls *)",
      "Bash(supabase *)"
    ],
    "deny": [
      "Bash(git push origin main)",
      "Bash(git push origin master)",
      "Bash(git push --force origin main)",
      "Bash(git push --force origin master)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(rm -rf *)",
      "Bash(* --no-verify*)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Write(**/.env)",
      "Write(**/.env.local)"
    ]
  }
}
